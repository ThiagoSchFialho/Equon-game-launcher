{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/infrastructure/**/*",
    "src/integrations/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "types": [
      "electron-vite/node"
    ]
  },
  "exclude": [
    "tests/renderer/**/*"
  ]
}
