# Editor and OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# TypeScript
*.tsbuildinfo

# Tool caches
.eslintcache

# Licensed assets that must not be redistributed (the repo is public): kept locally only.
